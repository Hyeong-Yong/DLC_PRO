<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20" Background="{DynamicResource PrimaryBackgroundGradient}" Width="600">
            <StackPanel Spacing="15">
                <Button Content="Home" />
                <Button Classes="small" Content="Small" />
                <Button Classes="subtle" Content="Home" />
                <IconButton IconText="&#xe2c2;" Content="Home" HorizontalAlignment="Stretch" />
                <CheckBox>Has Content</CheckBox>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- 기본 글꼴 (BatchProcess3 General.axaml 기반) -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}" />
    </Style>

    <!-- 사이드 메뉴 폭 애니메이션 (BatchProcess3와 동일한 1초 → 0.25초로 단축, 사이드바에만 적용) -->
    <Style Selector="Border.sidebar">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.25" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="TextBlock.icon-outline">
        <Setter Property="FontFamily" Value="{DynamicResource Phosphor}" />
    </Style>
    <Style Selector="Label.icon-outline">
        <Setter Property="FontFamily" Value="{DynamicResource Phosphor}" />
    </Style>
    <Style Selector="IconButton.icon-outline /template/ Label#IconLabel">
        <Setter Property="FontFamily" Value="{DynamicResource Phosphor}" />
    </Style>

    <!-- 아이콘 전용 TextBlock -->
    <Style Selector="TextBlock.icon">
        <Setter Property="FontFamily" Value="{DynamicResource PhosphorFill}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</Styles>
